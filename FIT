double media(vector<double>);
double var(vector<double>,double);
double rho(vector<double>, vector<double>);

double media(vector<double> dati){

        double somma=0.;

        for ( auto i : dati) {
                somma = somma + i; 
        }
        double media= somma / dati.size();

	return media ;
}

double varN( vector<double> dati, double media){

        double somma2=0.;

        for ( auto i : dati){
                somma2 =  somma2 + pow (i - media, 2); 
        }
        double var = somma2/ ( dati.size()) ; 

        return var;
}

double rho (vector<double> X, vector<double> Y){
	double num, den;
	double sc_x, sc_y;
	double somma2x, somma2y;

	for(int i=0; i<X.size(); ++i){
		sc_x=X.at(i)-media(X);
		sc_y=Y.at(i)-media(Y);
		num += sc_x*sc_y;
		somma2x += pow(sc_x,2);
		somma2y += pow(sc_y,2);
	}

	den= somma2x*somma2y;

	return num/sqrt(den);
}

