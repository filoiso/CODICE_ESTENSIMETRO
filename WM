using namespace std;

double media_pesata(vector<double>, vector <double>);
double inc_wmean(vector<double>);

double media_pesata(vector<double> data, vector<double> inc){
    
    double num=0., den=0.;

    for (int i=0; i<data.size(); ++i){
        num += data.at(i)/pow(inc.at(i),2);
        den += 1./pow(inc.at(i),2);
    }

    double wmean= num/den;
    return wmean;
}

double inc_wmean(vector<double> inc){
    double sum=0;
    for (auto i:inc){
        sum += 1./pow(i,2);
    }
    
    double wmeaninc=sqrt(1./sum);
    
    return wmeaninc;
}


